          "title": "Sku",
          "type": "string"
        },
        "zone_id": {
          "title": "Zone Id",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {

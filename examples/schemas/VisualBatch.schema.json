        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "visibility": {
          "maximum": 1,
          "minimum": 0,
          "title": "Visibility",
          "type": "number"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }

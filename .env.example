# Copy to .env. Never commit .env or runtime/. Defaults make NO paid calls.
RETAIL_PULSE_MODE=demo
RETAIL_PULSE_HOME=runtime
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
# Set true only for footage/data you are authorized to send to Meta.
ALLOW_EXTERNAL_MEDIA=false
# Only the standard model is enabled by default; contributor mode needs separate consent.
ALLOW_CONTRIBUTOR_MODE=false
# Local guard, NOT an authoritative provider bill. Includes conservative per-call reservations.
API_BUDGET_USD=20
API_CALL_RESERVATION_USD=0.50
MUSE_INPUT_USD_PER_MILLION=1.25
MUSE_CACHED_USD_PER_MILLION=0.15
MUSE_OUTPUT_USD_PER_MILLION=4.25
SAM_IMAGE_USD=0.0025
SAM_FRAME_USD=0.0002
MAX_AGENT_ROUNDS=5
MAX_OUTPUT_TOKENS=5000
META_TIMEOUT_SECONDS=180
MAX_MEDIA_MB=25
MAX_VIDEO_SECONDS=90
# Optional shared token for the LOCAL API; mandatory to bind beyond loopback.
RETAIL_PULSE_API_TOKEN=
STORE_TIMEZONE=America/Denver
OPEN_HOUR=8
CLOSE_HOUR=20
MIN_OBSERVATION_CONFIDENCE=0.75
MIN_VISIBILITY=0.70
RFID_DETECTION_PROBABILITY=
# Empty = only use positive reads as a lower bound; NEVER infer loss from absent tags.
